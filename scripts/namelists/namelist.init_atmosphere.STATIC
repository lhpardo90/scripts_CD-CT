&nhyd_model
    config_init_case = 7
    config_start_time = '2010-10-23_00:00:00'
    config_stop_time = '2010-10-23_00:00:00'
    config_theta_adv_order = 3
    config_coef_3rd_order = 0.25
/
&dimensions
    config_nvertlevels = 1
    config_nsoillevels = 1
    config_nfglevels = 1
    config_nfgsoillevels = 1
/
&data_sources
    config_geog_data_path = '#GEODAT#'
    config_met_prefix = 'GFS'
    config_sfc_prefix = 'SST'
    config_fg_interval = 86400
    config_landuse_data = 'MODIFIED_IGBP_MODIS_NOAH'
    config_soilcol_data = 'MODIFIED_RAD_CLM_NOAH'
    config_topo_data = 'GMTED2010'
    config_use_spechumd = false
/
&vertical_grid
    config_ztop = 30000.0                    ! Model top height [m]
                                             ! Positive real values (default: 30000.0)
    config_nsmterrain = 1
    config_smooth_surfaces = true
    config_dzmin = 0.3
    config_nsm = 30
    config_tc_vertical_grid = false        ! Use the vertical grid developed for
                                           ! real-time tropical-cyclone experiments (default: true).
    config_bonatti_vertical_grid = true    ! Use the Bonatti zeta3 vertical grid.
                                           ! This grid increases vertical resolution
                                           ! in the lower atmosphere using a cubic
                                           ! polynomial in fractional level index (default: false).
    config_bonatti_zeta0 = 40.0            ! Target thickness [m] of the first model
                                           ! layer above the surface when the Bonatti
                                           ! vertical grid is enabled (typically >= 30.0, default: 40.0).
    config_bonatti_fm = 0.8                ! Fractional level index at which the
                                           ! Bonatti vertical coordinate reaches
                                           ! half of the model-top height
                                           ! (expected range: 0.5 to 0.8, default: 0.8)
/
&interpolation_control
    config_extrap_airtemp = 'linear'
/
&preproc_stages
    config_static_interp = true
    config_native_gwd_static = true
    config_native_gwd_gsl_static = true  
    config_vertical_grid = false
    config_met_interp = false
    config_input_sst = false
    config_frac_seaice = false
/
&io
    config_pio_num_iotasks = 0
    config_pio_stride = 1
/
&decomposition
    config_block_decomp_file_prefix = 'x1.#RES#.graph.info.part.'
/
