# MONAN source
github_link="https://github.com/monanadmin/MONAN-Model.git"
monan_branch=2.0.0-rc
convertmpas_branch=1.2.0

# Experiment
EXP=GFS

# Grid resolution
# 40962   = 120 km
# 163842  = 60 km
# 655362  = 30 km
# 1024002 = 24 km
# 2621442 = 15 km
# 5898242 = 10 km
RES=655362

# Number of levels
N_MODEL_LEV=55

# Initial date: YYYYMMDDHH
YYYYMMDDHHi=2024010100

# Output directory name
RUN_ID=${YYYYMMDDHHi}

# COLD or RESTART
INIT_MODE=COLD

# Restart checkpoint time (YYYYMMDDHH).
# Only used when INIT_MODE=RESTART
# Keep YYYYMMDDHHi and RUN_ID unchanged between restart segments.
YYYYMMDDHHi_restart=2024010200

# Integration time (hours)
FCST=48

# Namelist/configuration variant
VARTABLE=".OPER"

# Output intervals
DIAG_INTERVAL="01:00:00"
HIST_INTERVAL="03:00:00"
RESTART_INTERVAL="24:00:00"

# MODEL resources (PBS / ian, pure MPI)
MODEL_NODES=8
MODEL_MPI_PER_NODE=256
MODEL_REQUESTED_WALLTIME="01:30:00"

# auto: choose a compatible research queue.
# manual: use MODEL_MANUAL_QUEUE.
MODEL_QUEUE_MODE=auto
MODEL_MANUAL_QUEUE=pesqextra
